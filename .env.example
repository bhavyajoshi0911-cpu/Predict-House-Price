# HomeValue AI - Environment Configuration Example
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=homevalue-ai-development-secret-key-change-in-prod
DATABASE_PATH=instance/predictions.db
DATASET_PATH=data/kc_house_data.csv
MODEL_PATH=models/model_pipeline.joblib
METADATA_PATH=models/model_metadata.json
DEFAULT_CURRENCY=USD
USD_TO_INR_RATE=83.5
PORT=5000
